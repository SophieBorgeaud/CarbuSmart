                                                "status": {
                                                    "type": "string",
                                                    "const": "success"
                                                },
                                                "vehicule": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "nom_vehicule": {
                                                            "type": "string"
                                                        },
                                                        "conso_moyenne": {
                                                            "type": "number"
                                                        },
                                                        "carburant": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "id",
                                                        "nom_vehicule",
                                                        "conso_moyenne",
                                                        "carburant"
                                                    ]
                                                },
                                                "quantite_litres": {
                                                    "type": [
                                                        "number",
                                                        "null"
                                                    ]
                                                },
                                                "best_station": {
                                                    "type": "string"
                                                },
                                                "data": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "vehicule",
                                                "quantite_litres",
                                                "best_station",
                                                "data"
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "const": "info"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "const": "Position inconnue. Fournissez des coordonn\u00e9es pour calculer la distance."
                                                },
                                                "data": {
                                                    "type": "array",
                                                    "items": {}
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "message",
                                                "data"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    },
